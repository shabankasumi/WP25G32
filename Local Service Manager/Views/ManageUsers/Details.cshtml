@using Microsoft.AspNetCore.Identity
@model IdentityUser

<h2>User Details</h2>

<div class="card">
    <div class="card-body">
        <p><b>Email:</b> @Model.Email</p>
        <p><b>Username:</b> @Model.UserName</p>
        <p><b>Id:</b> @Model.Id</p>
        <p><b>Email Confirmed:</b> @Model.EmailConfirmed</p>
    </div>
</div>

<div class="mt-3">
    <a class="btn btn-secondary" asp-action="Index">Back</a>
</div>

