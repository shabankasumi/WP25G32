@using Microsoft.AspNetCore.Identity
@model IdentityUser

@{
    ViewData["Title"] = "Edit User";
    var roles = ViewBag.Roles as List<string> ?? new();
    var currentRole = ViewBag.CurrentRole as string ?? "";
}

<h2>Edit User</h2>

<div class="mb-3">
    <span class="text-muted">User ID:</span> <span class="fw-semibold">@Model.Id</span>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label class="form-label">Email</label>
        <input name="email" value="@Model.Email" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Username</label>
        <input name="userName" value="@Model.UserName" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Phone number</label>
        <input name="phoneNumber" value="@Model.PhoneNumber" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Role</label>
        <select name="role" class="form-select">
            <option value="">-- none --</option>
            @foreach (var r in roles)
            {
                if (r == currentRole)
                {
                    <option value="@r" selected>@r</option>
                }
                else
                {
                    <option value="@r">@r</option>
                }
            }
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">New password (optional)</label>
        <input name="newPassword" type="password" class="form-control" />
        <div class="form-text">Leave empty to keep the current password.</div>
    </div>

    <button class="btn btn-primary" type="submit">Save changes</button>
    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
