@model IEnumerable<Local_Service_Manager.Models.Reservation>

@{
    ViewData["Title"] = "Manage Reservations";
    Func<string,string> badgeClass = (status) => status switch
    {
        "Approved" => "bg-success",
        "Cancelled" => "bg-danger",
        _ => "bg-warning text-dark"
    };
}

<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
    <h2 class="mb-0">@ViewData["Title"]</h2>
</div>

<form class="row g-2 mb-3" method="get">
    <div class="col-md-4">
        <input class="form-control" type="text" name="search" value="@ViewData["CurrentSearch"]" placeholder="Search by user email or service..." />
    </div>
    <div class="col-md-3">
        <select class="form-select" name="status">
            <option value="" selected="@(string.IsNullOrEmpty(ViewData["CurrentStatus"]?.ToString()))">All statuses</option>
            <option value="Pending" selected="@(ViewData["CurrentStatus"]?.ToString()=="Pending")">Pending</option>
            <option value="Approved" selected="@(ViewData["CurrentStatus"]?.ToString()=="Approved")">Approved</option>
            <option value="Cancelled" selected="@(ViewData["CurrentStatus"]?.ToString()=="Cancelled")">Cancelled</option>
        </select>
    </div>
    <div class="col-md-3">
        <select class="form-select" name="sortOrder">
            <option value="" selected="@(string.IsNullOrEmpty(ViewData["CurrentSort"]?.ToString()))">Date (oldest)</option>
            <option value="date_desc" selected="@(ViewData["CurrentSort"]?.ToString()=="date_desc")">Date (newest)</option>
        </select>
    </div>
    <div class="col-md-2">
        <button class="btn btn-primary w-100" type="submit">Apply</button>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>User</th>
                <th>Service</th>
                <th>Date</th>
                <th>Location</th>
                <th>Phone</th>
                <th>Status</th>
                <th class="text-end"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td class="small">@r.User?.Email</td>
                    <td>
                        <div class="fw-semibold">@r.Service?.Name</div>
                        @if (!string.IsNullOrWhiteSpace(r.Notes))
                        {
                            <div class="small opacity-75">@r.Notes</div>
                        }
                    </td>
                    <td>@r.ReservationDate.ToString("yyyy-MM-dd")</td>
                    <td>@r.Street, @r.City @r.Zip</td>
                    <td>@r.PhoneNumber</td>
                    <td><span class="badge badge-status @badgeClass(r.Status)">@r.Status</span></td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-light" asp-action="Details" asp-route-id="@r.Id">Details</a>

                        <form asp-action="SetStatus" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@r.Id" />
                            <input type="hidden" name="status" value="Approved" />
                            <button type="submit" class="btn btn-sm btn-outline-success">Approve</button>
                        </form>

                        <form asp-action="SetStatus" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@r.Id" />
                            <input type="hidden" name="status" value="Cancelled" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if ((int)ViewBag.TotalPages > 1)
{
    <nav class="mt-3" aria-label="Reservations pages">
        <ul class="pagination">
            @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
            {
                var active = i == (int)ViewBag.CurrentPage ? "active" : "";
                <li class="page-item @active">
                    <a class="page-link" href="?page=@i&search=@ViewData["CurrentSearch"]&status=@ViewData["CurrentStatus"]&sortOrder=@ViewData["CurrentSort"]">@i</a>
                </li>
            }
        </ul>
    </nav>
}
