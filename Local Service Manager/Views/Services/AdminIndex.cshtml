@model IEnumerable<Local_Service_Manager.Models.Service>

@{
    ViewData["Title"] = "Admin - Services";
}

<h2>Manage Services</h2>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-4">
        <label class="form-label">Search</label>
        <input class="form-control" type="text" name="search" value="@ViewData["CurrentSearch"]" placeholder="Name..." />
    </div>
    <div class="col-md-3">
        <label class="form-label">Category</label>
        <select class="form-select" name="category">
            <option value="" selected="@(string.IsNullOrEmpty((string?)ViewData["CurrentCategory"]) ? "selected" : null)">All</option>
            <option value="Transport" selected="@(((string?)ViewData["CurrentCategory"])=="Transport" ? "selected" : null)">Transport</option>
            <option value="Maintenance" selected="@(((string?)ViewData["CurrentCategory"])=="Maintenance" ? "selected" : null)">Maintenance</option>
            <option value="Cleaning" selected="@(((string?)ViewData["CurrentCategory"])=="Cleaning" ? "selected" : null)">Cleaning</option>
        </select>
    </div>
    <div class="col-md-3">
        <div class="form-check mt-4">
            <input class="form-check-input" type="checkbox" name="onlyActive" value="true" id="onlyActive" @( (ViewData["OnlyActive"] is bool b && b) ? "checked" : null) />
            <label class="form-check-label" for="onlyActive">Only Active</label>
        </div>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">Apply</button>
    </div>
</form>

<a asp-action="Create" class="btn btn-success mb-3">Add Service</a>


<table class="table">
    <thead>
        <tr>
            <th><a asp-route-sortOrder="@ViewData["NameSort"]">Name</a></th>
            <th>Category</th>
            <th><a asp-route-sortOrder="@ViewData["DateSort"]">Created</a></th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach(var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Category</td>
                <td>@item.CreatedAt.ToShortDateString()</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Permissions" asp-route-id="@item.Id">Permissions</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<div>
    @for(int i = 1; i <= (int)ViewBag.TotalPages; i++)
    {
        if (i == (int)ViewBag.CurrentPage)
        {
            <strong>@i</strong>
        }
        else
        {
            <a href="?page=@i&search=@ViewData["CurrentSearch"]&category=@ViewData["CurrentCategory"]&onlyActive=@ViewData["OnlyActive"]&sortOrder=@ViewData["CurrentSort"]">@i</a>
        }
    }
</div>
