@using Local_Service_Manager.Data
@inject ApplicationDbContext Db
@inject Microsoft.AspNetCore.Identity.UserManager<Microsoft.AspNetCore.Identity.IdentityUser> UserManager


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Local_Service_Manager</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.3/dist/darkly/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Local_Service_Manager.styles.css" asp-append-version="true" />
</head>
<body>

@{
    string? currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    string? currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    string Active(string controller, string? action = null)
    {
        bool controllerMatch = string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);
        bool actionMatch = action == null || string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
        return (controllerMatch && actionMatch) ? "active" : "";
    }

    bool isAuth = User.Identity?.IsAuthenticated == true;

    bool canMyServices = false;
    bool canServiceReservations = false;

    if (isAuth)
    {
        var userId = UserManager.GetUserId(User);

        if (!string.IsNullOrWhiteSpace(userId))
        {
            // Worker permission (same as ServicesController)
            bool isWorker = Db.UserPermissions.Any(p => p.UserId == userId && p.CanPostServices);

            // My Services only for workers (or Admin role - optional)
            canMyServices = isWorker || User.IsInRole("Admin");

            // Service Reservations ONLY for workers (and only if they actually have services)
            canServiceReservations = (isWorker || User.IsInRole("Admin"))
                && Db.Services.Any(s => s.CreatedByUserId == userId);
        }
    }
}



<header>
    <nav class="navbar navbar-expand-sm navbar-dark bg-dark border-bottom box-shadow mb-3">
        <div class="container-fluid">

            <a class="navbar-brand" asp-controller="Home" asp-action="Index">Local_Service_Manager</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#navbarSupportedContent">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarSupportedContent">

                <ul class="navbar-nav flex-grow-1">

                    <li class="nav-item">
                        <a class="nav-link @Active("Home","Index")" asp-controller="Home" asp-action="Index">Home</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @Active("ServicePublic","Index")" asp-controller="ServicePublic" asp-action="Index">Services</a>
                    </li>

                    @if (isAuth)
                    {
                        <li class="nav-item">
                            <a class="nav-link @Active("Reservations","My")" asp-controller="Reservations" asp-action="My">My Reservations</a>
                        </li>

                        @if (canMyServices)
                        {
                            <li class="nav-item">
                                <a class="nav-link @Active("Services","MyServices")" asp-controller="Services" asp-action="MyServices">My Services</a>
                            </li>
                        }

                        @if (canServiceReservations)
                        {
                            <li class="nav-item">
                                <a class="nav-link @Active("Reservations","MyServiceReservations")"
                                   asp-controller="Reservations"
                                   asp-action="MyServiceReservations">Service Reservations</a>
                            </li>
                        }
                    }

                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Admin</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="ManageUsers" asp-action="Index">User Management</a></li>
                                <li><a class="dropdown-item" asp-controller="Services" asp-action="AdminIndex">Manage Services</a></li>
                                <li><a class="dropdown-item" asp-controller="Reservations" asp-action="Index">Manage Reservations</a></li>
                            </ul>
                        </li>
                    }

                </ul>

                <ul class="navbar-nav">

                    @if (isAuth)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Identity" asp-page="/Account/Manage/Index">
                                @User.Identity!.Name
                            </a>
                        </li>

                        <li class="nav-item">
                            <form asp-area="Identity" asp-page="/Account/Logout" method="post">
                                <button type="submit" class="btn btn-link nav-link">Logout</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Login</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-area="Identity" asp-page="/Account/Register">Register</a>
                        </li>
                    }

                </ul>

            </div>
        </div>
    </nav>
</header>

<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="border-top footer text-muted">
    <div class="container">
        &copy; 2025 - Local_Service_Manager -
        <a asp-controller="Home" asp-action="Privacy">Privacy</a>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
