@{
    ViewData["Title"] = "Home";
}

<div class="py-5">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <h1 class="display-5 fw-bold">Book local services in minutes</h1>
                <p class="lead opacity-75">
                    Choose a service, pick a date, enter your location & phone number, and we’ll confirm your reservation quickly.
                </p>

                <div class="d-flex gap-2 flex-wrap">
                    <a class="btn btn-primary btn-lg" asp-controller="ServicePublic" asp-action="Index">
                        Browse Services
                    </a>

                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <a class="btn btn-outline-light btn-lg" asp-controller="Reservations" asp-action="My">
                            My Reservations
                        </a>
                    }
                    else
                    {
                        <a class="btn btn-outline-light btn-lg" asp-area="Identity" asp-page="/Account/Login">
                            Login to Reserve
                        </a>
                    }
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card shadow-sm">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3">How it works</h5>
                        <ol class="mb-0 opacity-75">
                            <li>Browse services</li>
                            <li>Click <strong>Reserve</strong> and enter your address</li>
                            <li>We review and confirm your booking</li>
                        </ol>
                    </div>
                </div>
            </div>
        </div>

        <hr class="my-5" />

        <div class="row g-3">
            <div class="col-md-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="fw-bold">Secure accounts</h5>
                        <p class="opacity-75 mb-0">Login with ASP.NET Identity and manage your reservations anytime.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="fw-bold">Clear booking details</h5>
                        <p class="opacity-75 mb-0">Each reservation stores location and phone number for faster approval.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="fw-bold">Admin approval</h5>
                        <p class="opacity-75 mb-0">Admins can approve/cancel reservations and see full customer details.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
